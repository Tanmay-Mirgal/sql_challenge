{
  "name": "sql-challenge-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB + PostgreSQL execution backend for the college SQL challenge platform",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sql:init": "tsx --env-file-if-exists=.env scripts/init-sql-engine.ts",
    "db:indexes": "tsx --env-file-if-exists=.env scripts/sync-indexes.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "admin:bootstrap:prod": "node dist/scripts/bootstrap-admin.js",
    "secrets:generate": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "libpg-query": "^18.1.5",
    "mongoose": "^9.11.1",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}

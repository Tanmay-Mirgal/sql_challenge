# --- Browser-visible (NEXT_PUBLIC_*) — never put secrets here ---------------------------------
# Base URL of the Express API (including the /api/v1 prefix).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Origin of the Socket.IO server (same host as the API).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# NOTE: NEXT_PUBLIC_GOOGLE_CLIENT_ID is intentionally absent. Google sign-in uses the
# server-side authorization-code flow (the browser is redirected by the API), so the
# OAuth client id never needs to be shipped to the browser.

# --- Server-only (read by the Next.js server, never sent to the browser) ------------------------
# Optional: URL the Next.js server uses to reach the API (e.g. http://backend:4000/api/v1 in Docker).
# Defaults to NEXT_PUBLIC_API_BASE_URL.
# API_INTERNAL_URL=http://localhost:4000/api/v1
# Must match COOKIE_NAME in backend/.env.
SESSION_COOKIE_NAME=sql_challenge_session
